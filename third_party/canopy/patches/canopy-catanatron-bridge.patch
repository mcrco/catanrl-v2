@@ -0,0 +1,576 @@
+//! JSON-lines bridge for evaluating the released Canopy Catan model on
+//! authoritative Catanatron states.
+//!
+//! The Python side owns the actual game.  Each request contains a batch of
+//! complete decision-state snapshots.  We reconstruct Canopy's search state,
+//! run all searches in lockstep so neural evaluations are batched on the GPU,
+//! and return Canopy action IDs.  No Catanatron state or action representation
+//! is modified by this adapter.
+
+use std::io::{BufRead, Write};
+use std::sync::Arc;
+use std::{collections::HashMap, collections::HashSet};
+
+use canopy::eval::{Evaluation, Evaluator};
+use canopy::mcts::{Config, LeafId, Search, Select};
+use canopy::player::Player;
+use serde::{Deserialize, Serialize};
+
+use crate::game::board::{NodeId, Terrain};
+use crate::game::dev_card::{DevCardArray, DevCardDeck};
+use crate::game::dice::Dice;
+use crate::game::resource::{Resource, ResourceArray};
+use crate::game::road::RoadNetwork;
+use crate::game::state::{GameState, Phase, PlayerBoards, PlayerState};
+use crate::game::topology::{PORT_SPECS, Topology};
+
+#[derive(Deserialize)]
+struct BridgeRequest {
+    id: u64,
+    active_game_ids: Option<Vec<String>>,
+    states: Vec<StateSnapshot>,
+}
+
+#[derive(Serialize)]
+struct BridgeResponse {
+    id: u64,
+    actions: Vec<usize>,
+}
+
+#[derive(Serialize)]
+struct BridgeError<'a> {
+    id: Option<u64>,
+    error: &'a str,
+}
+
+#[derive(Deserialize)]
+struct StateSnapshot {
+    game_id: String,
+    tree_actions: Vec<usize>,
+    reuse_tree: bool,
+    terrains: Vec<String>,
+    numbers: Vec<Option<u8>>,
+    ports: Vec<Option<String>>,
+    tile_nodes: Vec<[u8; 6]>,
+    tile_edges: Vec<[u8; 6]>,
+    players: [PlayerSnapshot; 2],
+    settlements: [Vec<u8>; 2],
+    cities: [Vec<u8>; 2],
+    roads: [Vec<u8>; 2],
+    bank: [u8; 5],
+    dev_deck_total: u8,
+    robber: u8,
+    current_player: usize,
+    phase: PhaseSnapshot,
+    turn_number: u16,
+    pre_roll: bool,
+    setup_count: u8,
+    last_setup_node: Option<u8>,
+    longest_road: Option<AwardSnapshot>,
+    largest_army: Option<AwardSnapshot>,
+    vp_limit: u8,
+    discard_threshold: u8,
+    settlements_at_turn_start: Vec<u8>,
+    roads_placed_at_turn_start: u8,
+}
+
+#[derive(Deserialize)]
+struct PlayerSnapshot {
+    hand: [u8; 5],
+    dev_cards: [u8; 5],
+    dev_cards_bought_this_turn: [u8; 5],
+    dev_cards_played: [u8; 5],
+    knights_played: u8,
+    roads_placed: u8,
+    settlements_left: u8,
+    cities_left: u8,
+    roads_left: u8,
+    has_played_dev_card_this_turn: bool,
+    has_traded_this_turn: bool,
+    building_vps: u8,
+    trade_ratios: [u8; 5],
+    #[serde(default)]
+    tested_non_knight: u8,
+}
+
+#[derive(Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum PhaseSnapshot {
+    PlaceSettlement,
+    PlaceRoad,
+    PreRoll,
+    Discard { remaining: u8, roller: usize },
+    MoveRobber,
+    Main,
+    RoadBuilding { roads_left: u8 },
+}
+
+#[derive(Deserialize)]
+struct AwardSnapshot {
+    player: usize,
+    length: u8,
+}
+
+fn player(index: usize) -> Result<Player, String> {
+    match index {
+        0 => Ok(Player::One),
+        1 => Ok(Player::Two),
+        _ => Err(format!("invalid player index {index}")),
+    }
+}
+
+fn resource(name: &str) -> Result<Resource, String> {
+    match name {
+        "WOOD" => Ok(Resource::Lumber),
+        "BRICK" => Ok(Resource::Brick),
+        "SHEEP" => Ok(Resource::Wool),
+        "WHEAT" => Ok(Resource::Grain),
+        "ORE" => Ok(Resource::Ore),
+        _ => Err(format!("invalid resource {name:?}")),
+    }
+}
+
+fn terrain(name: &str) -> Result<Terrain, String> {
+    match name {
+        "WOOD" => Ok(Terrain::Forest),
+        "BRICK" => Ok(Terrain::Hills),
+        "SHEEP" => Ok(Terrain::Pasture),
+        "WHEAT" => Ok(Terrain::Fields),
+        "ORE" => Ok(Terrain::Mountains),
+        "DESERT" => Ok(Terrain::Desert),
+        _ => Err(format!("invalid terrain {name:?}")),
+    }
+}
+
+fn mask(ids: &[u8], limit: u8, label: &str) -> Result<u64, String> {
+    let mut result = 0u64;
+    for &id in ids {
+        if id >= limit {
+            return Err(format!("{label} id {id} is outside 0..{limit}"));
+        }
+        result |= 1u64 << id;
+    }
+    Ok(result)
+}
+
+fn road_mask(ids: &[u8]) -> Result<u128, String> {
+    let mut result = 0u128;
+    for &id in ids {
+        if id >= 72 {
+            return Err(format!("road id {id} is outside 0..72"));
+        }
+        result |= 1u128 << id;
+    }
+    Ok(result)
+}
+
+struct ImportedState {
+    game_id: String,
+    tree_actions: Vec<usize>,
+    reuse_tree: bool,
+    state: GameState,
+}
+
+fn build_state(snapshot: StateSnapshot) -> Result<ImportedState, String> {
+    let terrains: [Terrain; 19] = snapshot
+        .terrains
+        .iter()
+        .map(|name| terrain(name))
+        .collect::<Result<Vec<_>, _>>()?
+        .try_into()
+        .map_err(|values: Vec<Terrain>| format!("expected 19 terrains, got {}", values.len()))?;
+    let numbers: [Option<u8>; 19] = snapshot
+        .numbers
+        .try_into()
+        .map_err(|values: Vec<Option<u8>>| format!("expected 19 numbers, got {}", values.len()))?;
+    let ports: [Option<Resource>; 9] = snapshot
+        .ports
+        .iter()
+        .map(|value| value.as_deref().map(resource).transpose())
+        .collect::<Result<Vec<_>, _>>()?
+        .try_into()
+        .map_err(|values: Vec<Option<Resource>>| {
+            format!("expected 9 port resources, got {}", values.len())
+        })?;
+
+    let topology = Arc::new(Topology::from_layout_with_ports(
+        terrains,
+        numbers,
+        ports,
+        &PORT_SPECS,
+    ));
+    if snapshot.tile_nodes.len() != 19 || snapshot.tile_edges.len() != 19 {
+        return Err(format!(
+            "expected 19 tile node/edge mappings, got {}/{}",
+            snapshot.tile_nodes.len(),
+            snapshot.tile_edges.len()
+        ));
+    }
+    for (index, tile) in topology.tiles.iter().enumerate() {
+        let expected_nodes = tile.nodes.map(|node| node.0);
+        let expected_edges = tile.edges.map(|edge| edge.0);
+        if snapshot.tile_nodes[index] != expected_nodes {
+            return Err(format!(
+                "Catanatron/Canopy node indexing mismatch on tile {index}: {:?} != {:?}",
+                snapshot.tile_nodes[index], expected_nodes
+            ));
+        }
+        if snapshot.tile_edges[index] != expected_edges {
+            return Err(format!(
+                "Catanatron/Canopy edge indexing mismatch on tile {index}: {:?} != {:?}",
+                snapshot.tile_edges[index], expected_edges
+            ));
+        }
+    }
+    let mut state = GameState::new(
+        topology,
+        DevCardDeck {
+            total: snapshot.dev_deck_total,
+        },
+        Dice::Random,
+    );
+
+    let settlement_masks = [
+        mask(&snapshot.settlements[0], 54, "settlement")?,
+        mask(&snapshot.settlements[1], 54, "settlement")?,
+    ];
+    let city_masks = [
+        mask(&snapshot.cities[0], 54, "city")?,
+        mask(&snapshot.cities[1], 54, "city")?,
+    ];
+    let road_masks = [
+        road_mask(&snapshot.roads[0])?,
+        road_mask(&snapshot.roads[1])?,
+    ];
+
+    for index in 0..2 {
+        let pid = player(index)?;
+        let p = &snapshot.players[index];
+        state.players[pid] = PlayerState {
+            hand: ResourceArray(p.hand),
+            dev_cards: DevCardArray(p.dev_cards),
+            dev_cards_bought_this_turn: DevCardArray(p.dev_cards_bought_this_turn),
+            knights_played: p.knights_played,
+            roads_placed: p.roads_placed,
+            settlements_left: p.settlements_left,
+            cities_left: p.cities_left,
+            roads_left: p.roads_left,
+            has_played_dev_card_this_turn: p.has_played_dev_card_this_turn,
+            has_traded_this_turn: p.has_traded_this_turn,
+            dev_cards_played: DevCardArray(p.dev_cards_played),
+            hidden_dev_cards: 0,
+            hidden_dev_cards_bought_this_turn: 0,
+            building_vps: p.building_vps,
+            trade_ratios: p.trade_ratios,
+            tested_non_knight: p.tested_non_knight,
+        };
+        state.boards[pid] = PlayerBoards {
+            settlements: settlement_masks[index],
+            cities: city_masks[index],
+            road_network: RoadNetwork::from_snapshot(
+                road_masks[index],
+                settlement_masks[index] | city_masks[index],
+                settlement_masks[1 - index] | city_masks[1 - index],
+                road_masks[1 - index],
+                &state.topology.adj,
+            ),
+        };
+    }
+
+    state.bank = ResourceArray(snapshot.bank);
+    if snapshot.robber >= 19 {
+        return Err(format!("robber tile {} is outside 0..19", snapshot.robber));
+    }
+    state.robber = crate::game::board::TileId(snapshot.robber);
+    state.current_player = player(snapshot.current_player)?;
+    state.phase = match snapshot.phase {
+        PhaseSnapshot::PlaceSettlement => Phase::PlaceSettlement,
+        PhaseSnapshot::PlaceRoad => Phase::PlaceRoad,
+        PhaseSnapshot::PreRoll => Phase::PreRoll,
+        PhaseSnapshot::Discard { remaining, roller } => Phase::Discard {
+            player: state.current_player,
+            remaining,
+            roller: player(roller)?,
+            min_resource: 0,
+        },
+        PhaseSnapshot::MoveRobber => Phase::MoveRobber,
+        PhaseSnapshot::Main => Phase::Main,
+        PhaseSnapshot::RoadBuilding { roads_left } => Phase::RoadBuilding { roads_left },
+    };
+    state.turn_number = snapshot.turn_number;
+    state.pre_roll = snapshot.pre_roll;
+    state.setup_count = snapshot.setup_count;
+    state.last_setup_node = snapshot.last_setup_node.map(NodeId);
+    state.longest_road = match snapshot.longest_road {
+        Some(award) => Some((player(award.player)?, award.length)),
+        None => None,
+    };
+    state.largest_army = match snapshot.largest_army {
+        Some(award) => Some((player(award.player)?, award.length)),
+        None => None,
+    };
+    state.vp_limit = snapshot.vp_limit;
+    state.discard_threshold = snapshot.discard_threshold;
+    state.friendly_robber = false;
+    state.settlements_at_turn_start = mask(
+        &snapshot.settlements_at_turn_start,
+        54,
+        "turn-start settlement",
+    )?;
+    state.roads_placed_at_turn_start = snapshot.roads_placed_at_turn_start;
+    // Preserve Canopy's canonical search pruning. It only removes dominated
+    // action orderings/targets inside the bot's search; every selected action
+    // is still resolved against Catanatron's authoritative legal-action list.
+    state.canonical_build_order = true;
+    state.min_step = 0;
+    state.min_trade_idx = 0;
+    state.min_city_node = 0;
+    state.min_road_key = 0;
+    state.min_settle_node = 0;
+    state.min_port_settle_node = 0;
+    state.compute_road_distances();
+    Ok(ImportedState {
+        game_id: snapshot.game_id,
+        tree_actions: snapshot.tree_actions,
+        reuse_tree: snapshot.reuse_tree,
+        state,
+    })
+}
+
+struct PendingLeaf {
+    search_index: usize,
+    leaf: LeafId,
+    state: GameState,
+}
+
+fn same_authoritative_phase(left: &Phase, right: &Phase) -> bool {
+    match (left, right) {
+        (
+            Phase::Discard {
+                player: left_player,
+                remaining: left_remaining,
+                roller: left_roller,
+                ..
+            },
+            Phase::Discard {
+                player: right_player,
+                remaining: right_remaining,
+                roller: right_roller,
+                ..
+            },
+        ) => {
+            left_player == right_player
+                && left_remaining == right_remaining
+                && left_roller == right_roller
+        }
+        _ => left == right,
+    }
+}
+
+/// Compare every game field governed by authoritative Catanatron outcomes.
+///
+/// Canopy-only canonical ordering fields are intentionally excluded: when the
+/// real action path reaches the same authoritative position, the retained
+/// values are more exact than a root imported midway through a turn. In
+/// particular, discard `min_resource` and turn-start build snapshots encode
+/// how the retained subtree was canonicalized, not a Catanatron rule.
+fn same_authoritative_state(left: &GameState, right: &GameState) -> bool {
+    left.players == right.players
+        && left.current_player == right.current_player
+        && left.boards == right.boards
+        && left.bank == right.bank
+        && left.dev_deck == right.dev_deck
+        && left.robber == right.robber
+        && same_authoritative_phase(&left.phase, &right.phase)
+        && left.turn_number == right.turn_number
+        && left.pre_roll == right.pre_roll
+        && left.setup_count == right.setup_count
+        && left.longest_road == right.longest_road
+        && left.largest_army == right.largest_army
+        && left.dice == right.dice
+        && left.vp_limit == right.vp_limit
+        && left.discard_threshold == right.discard_threshold
+        && left.friendly_robber == right.friendly_robber
+        && left.last_setup_node == right.last_setup_node
+}
+
+#[cfg(test)]
+mod bridge_tests {
+    use super::*;
+
+    #[test]
+    fn retained_state_check_ignores_only_canopy_discard_ordering() {
+        let mut retained = GameState::from_seed(17, Dice::Random);
+        retained.current_player = Player::One;
+        retained.phase = Phase::Discard {
+            player: Player::One,
+            remaining: 3,
+            roller: Player::Two,
+            min_resource: 2,
+        };
+        let mut imported = retained.clone();
+        imported.phase = Phase::Discard {
+            player: Player::One,
+            remaining: 3,
+            roller: Player::Two,
+            min_resource: 0,
+        };
+        assert!(same_authoritative_state(&retained, &imported));
+
+        imported.current_player = Player::Two;
+        assert!(!same_authoritative_state(&retained, &imported));
+    }
+
+    #[test]
+    fn retained_state_check_rejects_authoritative_hand_drift() {
+        let retained = GameState::from_seed(19, Dice::Random);
+        let mut imported = retained.clone();
+        imported.players[Player::One].hand[Resource::Lumber] = 1;
+        assert!(!same_authoritative_state(&retained, &imported));
+    }
+}
+
+fn search_batch(
+    states: Vec<ImportedState>,
+    active_game_ids: Option<&[String]>,
+    evaluator: &(dyn Evaluator<GameState> + Sync),
+    simulations: u32,
+    rng: &mut fastrand::Rng,
+    saved_searches: &mut HashMap<String, Search<GameState>>,
+) -> Vec<usize> {
+    let config = Config {
+        num_simulations: simulations,
+        // Evaluation must be deterministic policy improvement, not noisy
+        // self-play exploration.
+        dirichlet_epsilon: 0.0,
+        ..Config::default()
+    };
+    let active_ids: HashSet<String> = active_game_ids
+        .map(|ids| ids.iter().cloned().collect())
+        .unwrap_or_else(|| states.iter().map(|state| state.game_id.clone()).collect());
+    saved_searches.retain(|game_id, _| active_ids.contains(game_id));
+
+    let mut game_ids = Vec::with_capacity(states.len());
+    let mut searches = Vec::with_capacity(states.len());
+    for imported in states {
+        let game_id = imported.game_id;
+        let mut search = saved_searches
+            .remove(&game_id)
+            .unwrap_or_else(|| Search::new(imported.state.clone(), config.clone()));
+        search.set_num_simulations(simulations);
+        if imported.reuse_tree {
+            let walked = search.walk_tree_exact(&imported.tree_actions);
+            if walked == imported.tree_actions.len()
+                && same_authoritative_state(search.state(), &imported.state)
+            {
+                search.cancel_search();
+            } else {
+                search.reset(imported.state);
+            }
+        } else {
+            search.reset(imported.state);
+        }
+        game_ids.push(game_id);
+        searches.push(search);
+    }
+    let mut actions = vec![None; searches.len()];
+
+    while actions.iter().any(Option::is_none) {
+        let mut pending = Vec::new();
+        for (index, search) in searches.iter_mut().enumerate() {
+            if actions[index].is_some() {
+                continue;
+            }
+            match search.select(rng) {
+                Select::Eval(leaf, state) => pending.push(PendingLeaf {
+                    search_index: index,
+                    leaf,
+                    state,
+                }),
+                Select::Terminal(leaf, wdl) => search.backup_terminal(leaf, wdl),
+                Select::Done => actions[index] = Some(search.result().selected_action),
+            }
+        }
+
+        if !pending.is_empty() {
+            let refs: Vec<&GameState> = pending.iter().map(|item| &item.state).collect();
+            let evaluations: Vec<Evaluation> = evaluator.evaluate_batch(&refs, rng);
+            for (item, evaluation) in pending.into_iter().zip(evaluations) {
+                searches[item.search_index].backup(item.leaf, evaluation);
+            }
+        }
+    }
+
+    for (game_id, search) in game_ids.into_iter().zip(searches) {
+        saved_searches.insert(game_id, search);
+    }
+    actions.into_iter().map(Option::unwrap).collect()
+}
+
+pub fn run(evaluator: Arc<dyn Evaluator<GameState> + Sync>, simulations: u32, seed: u64) {
+    let stdin = std::io::stdin();
+    let mut stdout = std::io::BufWriter::new(std::io::stdout().lock());
+    let mut rng = fastrand::Rng::with_seed(seed);
+    let mut saved_searches: HashMap<String, Search<GameState>> = HashMap::new();
+
+    for line in stdin.lock().lines() {
+        let line = match line {
+            Ok(line) if !line.trim().is_empty() => line,
+            Ok(_) => continue,
+            Err(error) => {
+                let message = error.to_string();
+                let response = BridgeError {
+                    id: None,
+                    error: &message,
+                };
+                serde_json::to_writer(&mut stdout, &response).unwrap();
+                writeln!(&mut stdout).unwrap();
+                stdout.flush().unwrap();
+                continue;
+            }
+        };
+
+        let request: BridgeRequest = match serde_json::from_str(&line) {
+            Ok(request) => request,
+            Err(error) => {
+                let message = error.to_string();
+                let response = BridgeError {
+                    id: None,
+                    error: &message,
+                };
+                serde_json::to_writer(&mut stdout, &response).unwrap();
+                writeln!(&mut stdout).unwrap();
+                stdout.flush().unwrap();
+                continue;
+            }
+        };
+        let request_id = request.id;
+        let active_game_ids = request.active_game_ids;
+        let states: Result<Vec<_>, _> = request.states.into_iter().map(build_state).collect();
+        match states {
+            Ok(states) => {
+                let response = BridgeResponse {
+                    id: request_id,
+                    actions: search_batch(
+                        states,
+                        active_game_ids.as_deref(),
+                        &*evaluator,
+                        simulations,
+                        &mut rng,
+                        &mut saved_searches,
+                    ),
+                };
+                serde_json::to_writer(&mut stdout, &response).unwrap();
+            }
+            Err(message) => {
+                let response = BridgeError {
+                    id: Some(request_id),
+                    error: &message,
+                };
+                serde_json::to_writer(&mut stdout, &response).unwrap();
+            }
+        }
+        writeln!(&mut stdout).unwrap();
+        stdout.flush().unwrap();
+    }
+}
