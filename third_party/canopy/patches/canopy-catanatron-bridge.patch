+    /// Walk through only exact, already-expanded children.
+    ///
+    /// Unlike [`Self::walk_tree`], this never substitutes the most-visited
+    /// chance outcome and never skips a trailing chance node.  External game
+    /// adapters use this when they have recorded the authoritative chance
+    /// outcomes: retaining a subtree for a different dice/card/steal outcome
+    /// would leave its root edges inconsistent with the imported state.
+    pub fn walk_tree_exact(&mut self, actions: &[usize]) -> usize {
+        let mut walked = 0;
+        for &action in actions {
+            let Some(root) = self.root else { break };
+            let Some(child) = self.tree.child_for_action(root, action) else {
+                break;
+            };
+            self.root = Some(child);
+            walked += 1;
+        }
+        self.needs_compact = true;
+        walked
+    }
