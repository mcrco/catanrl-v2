+/// Name the first authoritative field on which two states differ (diagnostics).
+fn first_difference(left: &GameState, right: &GameState) -> &'static str {
+    for pid in [Player::One, Player::Two] {
+        let (a, b) = (&left.players[pid], &right.players[pid]);
+        if a.hand != b.hand { return "players.hand"; }
+        if a.dev_cards != b.dev_cards { return "players.dev_cards"; }
+        if a.dev_cards_bought_this_turn != b.dev_cards_bought_this_turn { return "players.dev_cards_bought_this_turn"; }
+        if a.hidden_dev_cards != b.hidden_dev_cards { return "players.hidden_dev_cards"; }
+        if a.hidden_dev_cards_bought_this_turn != b.hidden_dev_cards_bought_this_turn { return "players.hidden_dev_cards_bought_this_turn"; }
+        if a.knights_played != b.knights_played { return "players.knights_played"; }
+        if a.roads_placed != b.roads_placed { return "players.roads_placed"; }
+        if a.has_played_dev_card_this_turn != b.has_played_dev_card_this_turn { return "players.has_played_dev_card_this_turn"; }
+        if a.has_traded_this_turn != b.has_traded_this_turn { return "players.has_traded_this_turn"; }
+        if a.dev_cards_played != b.dev_cards_played { return "players.dev_cards_played"; }
+        if a.trade_ratios != b.trade_ratios { return "players.trade_ratios"; }
+        if a.tested_non_knight != b.tested_non_knight { return "players.tested_non_knight"; }
+        if a != b { return "players.other"; }
+    }
+    if left.current_player != right.current_player { return "current_player"; }
+    for pid in [Player::One, Player::Two] {
+        let (a, b) = (&left.boards[pid], &right.boards[pid]);
+        if a.settlements != b.settlements { return "boards.settlements"; }
+        if a.cities != b.cities { return "boards.cities"; }
+        if a.road_network.roads != b.road_network.roads { return "boards.roads"; }
+        if a.road_network.reachable_edges() != b.road_network.reachable_edges() { return "boards.reachable"; }
+        if a.road_network.longest_road() != b.road_network.longest_road() { return "boards.longest_len"; }
+    }
+    if left.bank != right.bank { return "bank"; }
+    if left.dev_deck != right.dev_deck { return "dev_deck"; }
+    if left.robber != right.robber { return "robber"; }
+    if !same_authoritative_phase(&left.phase, &right.phase) { return "phase"; }
+    if left.turn_number != right.turn_number { return "turn_number"; }
+    if left.pre_roll != right.pre_roll { return "pre_roll"; }
+    if left.setup_count != right.setup_count { return "setup_count"; }
+    if left.longest_road != right.longest_road { return "longest_road"; }
+    if left.largest_army != right.largest_army { return "largest_army"; }
+    if left.dice != right.dice { return "dice"; }
+    if left.vp_limit != right.vp_limit { return "vp_limit"; }
+    if left.discard_threshold != right.discard_threshold { return "discard_threshold"; }
+    if left.friendly_robber != right.friendly_robber { return "friendly_robber"; }
+    if left.last_setup_node != right.last_setup_node { return "last_setup_node"; }
+    "none"
