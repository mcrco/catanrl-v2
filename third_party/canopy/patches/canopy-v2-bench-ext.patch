+
+fn mover_value(state: &GameState, p1_value: f32) -> f32 {
+    p1_value * state.current_player.sign()
+}
+
+fn softmax_over(logits: &[f32], actions: &[usize]) -> Vec<(usize, f32)> {
+    let max = actions
+        .iter()
+        .map(|&a| logits[a])
+        .fold(f32::NEG_INFINITY, f32::max);
+    let mut out: Vec<(usize, f32)> = actions.iter().map(|&a| (a, (logits[a] - max).exp())).collect();
+    let total: f32 = out.iter().map(|(_, w)| w).sum();
+    for item in &mut out {
+        item.1 /= total;
+    }
+    out
+}
