+fn is_dev_play(action: usize) -> bool {
+    action == PLAY_KNIGHT as usize
+        || action == PLAY_ROAD_BUILDING as usize
+        || (YOP_START as usize..MONOPOLY_END as usize).contains(&action)
+}
+
+/// Replay `actions` on a saved search (moving its root and advancing its root
+/// state).  Stops with a reason when an action cannot be replayed exactly or
+/// would need hidden information: any dev-card buy or play by the player who
+/// is not deciding now (their cards are hidden in Canopy's state).
+fn advance_saved_search(
+    search: &mut Search<GameState>,
+    actions: &[usize],
+    decider: Player,
+) -> Result<(), String> {
+    let mut legal = Vec::new();
+    let mut outcomes = Vec::new();
+    for (index, &action) in actions.iter().enumerate() {
+        let state = search.state();
+        match state.status() {
+            Status::Terminal(_) => return Err(format!("terminal_at_{index}")),
+            Status::Chance => {
+                // After a pre-roll knight + robber move Canopy goes straight to
+                // the dice chance node; Catanatron still records a ROLL action.
+                if matches!(state.phase, Phase::Roll) && action == ROLL as usize {
+                    continue;
+                }
+                outcomes.clear();
+                state.chance_outcomes(&mut outcomes);
+                if !outcomes.iter().any(|&(o, w)| o == action && w > 0) {
+                    return Err(format!("chance_outcome_{action}_impossible_at_{index}"));
+                }
+            }
+            Status::Decision(_) => {
+                if state.current_player != decider
+                    && (action == BUY_DEV_CARD as usize || is_dev_play(action))
+                {
+                    return Err(format!("opponent_dev_action_{action}_at_{index}"));
+                }
+                state.legal_actions(&mut legal);
+                if !legal.contains(&action) {
+                    return Err(format!("action_{action}_not_canopy_legal_at_{index}"));
+                }
+            }
+        }
+        search.apply_action(action);
+    }
+    Ok(())
+}
