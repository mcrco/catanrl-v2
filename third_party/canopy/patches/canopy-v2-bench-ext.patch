+fn topology_response(id: u64) -> TopologyResponse {
+    use crate::game::board::Port;
+    let terrains = [Terrain::Desert; 19];
+    let numbers = [None; 19];
+    // Port i is marked as a lumber port and every other port as generic, so the
+    // nodes carrying `Specific(Lumber)` are exactly port i's two nodes.
+    let port_nodes = |specs: &[(crate::game::hex::Hex, crate::game::hex::Direction); 9]| -> Vec<[u8; 2]> {
+        (0..9)
+            .map(|i| {
+                let mut ports = [None; 9];
+                ports[i] = Some(Resource::Lumber);
+                let topology = Topology::from_layout_with_ports(terrains, numbers, ports, specs);
+                let nodes: Vec<u8> = topology
+                    .nodes
+                    .iter()
+                    .filter(|n| n.port == Some(Port::Specific(Resource::Lumber)))
+                    .map(|n| n.id.0)
+                    .collect();
+                assert_eq!(nodes.len(), 2, "port {i} should touch two nodes");
+                [nodes[0], nodes[1]]
+            })
+            .collect()
+    };
+    let primary = Topology::from_layout_with_ports(terrains, numbers, [None; 9], &PORT_SPECS);
+    TopologyResponse {
+        id,
+        land_hexes_axial: crate::game::topology::LAND_HEXES
+            .iter()
+            .map(|h| (h.q, h.r))
+            .collect(),
+        tile_nodes: primary.tiles.iter().map(|t| t.nodes.map(|n| n.0)).collect(),
+        tile_edges: primary.tiles.iter().map(|t| t.edges.map(|e| e.0)).collect(),
+        edge_nodes: primary
+            .edges
+            .iter()
+            .map(|e| [e.nodes[0].0, e.nodes[1].0])
+            .collect(),
+        port_nodes_primary: port_nodes(&PORT_SPECS),
+        port_nodes_alt: port_nodes(&PORT_SPECS_ALT),
+    }
 }
 
